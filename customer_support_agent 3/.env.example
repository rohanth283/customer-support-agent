# Copy this file to .env to use the local Ollama model.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT=180

# Optional cloud alternatives (set LLM_PROVIDER accordingly):
# LLM_PROVIDER=gemini
# LLM_PROVIDER=openai
# GEMINI_API_KEY=""
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_API_KEY=""
